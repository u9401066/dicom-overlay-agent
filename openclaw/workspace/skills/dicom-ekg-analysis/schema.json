{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "modality",
    "layout",
    "summary",
    "severity",
    "findings",
    "checklist",
    "image_quality",
    "next_steps",
    "model_used",
    "incomplete",
    "incomplete_reasons"
  ],
  "properties": {
    "modality": {"const": "EKG"},
    "analysis_time_ms": {"type": "integer", "minimum": 0},
    "layout": {
      "type": "object",
      "required": ["format", "rhythm_strip_leads", "leads"],
      "properties": {
        "format": {
          "type": "string",
          "enum": [
            "12lead_3x4",
            "12lead_3x4_rhythm",
            "6lead",
            "3lead",
            "single_rhythm_strip",
            "partial",
            "non_standard",
            "unknown"
          ]
        },
        "rhythm_strip_leads": {
          "type": "array",
          "items": {"type": "string"},
          "uniqueItems": true
        },
        "rhythm_strip_bbox": {
          "oneOf": [
            {
              "type": "array",
              "prefixItems": [
                {"type": "number", "minimum": 0, "maximum": 1},
                {"type": "number", "minimum": 0, "maximum": 1},
                {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
                {"type": "number", "exclusiveMinimum": 0, "maximum": 1}
              ],
              "minItems": 4,
              "maxItems": 4
            },
            {"type": "null"}
          ]
        },
        "leads": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "label_visible", "bbox"],
            "properties": {
              "name": {"type": "string"},
              "label_visible": {"type": "boolean"},
              "bbox": {
                "type": "array",
                "prefixItems": [
                  {"type": "number", "minimum": 0, "maximum": 1},
                  {"type": "number", "minimum": 0, "maximum": 1},
                  {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
                  {"type": "number", "exclusiveMinimum": 0, "maximum": 1}
                ],
                "minItems": 4,
                "maxItems": 4
              }
            },
            "additionalProperties": false
          }
        },
        "notes": {"type": "string"}
      },
      "additionalProperties": false
    },
    "summary": {"type": "string"},
    "severity": {"type": "string", "enum": ["critical", "warning", "normal", "info"]},
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "regions", "label", "detail", "severity", "bboxes"],
        "properties": {
          "id": {"type": "string"},
          "regions": {"type": "array", "items": {"type": "string"}},
          "label": {"type": "string"},
          "detail": {"type": "string"},
          "severity": {"type": "string", "enum": ["critical", "warning", "normal", "info"]},
          "confidence": {
            "type": "string",
            "enum": ["high", "moderate", "low"]
          },
          "question": {"type": "string"},
          "bboxes": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["x", "y", "w", "h"],
              "properties": {
                "x": {"type": "number", "minimum": 0, "maximum": 1},
                "y": {"type": "number", "minimum": 0, "maximum": 1},
                "w": {"type": "number", "exclusiveMinimum": 0, "maximum": 0.35},
                "h": {"type": "number", "exclusiveMinimum": 0, "maximum": 0.3}
              },
              "additionalProperties": false
            }
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {"severity": {"const": "normal"}},
              "required": ["severity"]
            },
            "then": {
              "properties": {"bboxes": {"maxItems": 0}}
            }
          }
        ],
        "additionalProperties": false
      }
    },
    "checklist": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["value", "status"],
        "properties": {
          "value": {"type": "string"},
          "status": {"type": "string", "enum": ["critical", "warning", "normal", "info"]}
        },
        "additionalProperties": false
      }
    },
    "image_quality": {
      "oneOf": [
        {"type": "string"},
        {
          "type": "object",
          "required": ["adequacy", "issues", "detail"],
          "properties": {
            "adequacy": {
              "type": "string",
              "enum": ["diagnostic", "limited", "non_diagnostic"]
            },
            "issues": {"type": "array", "items": {"type": "string"}},
            "detail": {"type": "string"}
          },
          "additionalProperties": false
        }
      ]
    },
    "next_steps": {
      "type": "array",
      "items": {"type": "string"},
      "minItems": 1
    },
    "model_used": {"type": "string"},
    "incomplete": {"type": "boolean"},
    "incomplete_reasons": {
      "type": "array",
      "items": {"type": "string"}
    }
  },
  "additionalProperties": false
}
