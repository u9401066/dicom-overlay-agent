{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["modality", "summary", "severity", "findings", "checklist"],
  "properties": {
    "modality": {"const": "EKG"},
    "analysis_time_ms": {"type": "integer", "minimum": 0},
    "summary": {"type": "string"},
    "severity": {"type": "string", "enum": ["critical", "warning", "normal", "info"]},
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "regions", "label", "detail", "severity"],
        "properties": {
          "id": {"type": "string"},
          "regions": {"type": "array", "items": {"type": "string"}},
          "label": {"type": "string"},
          "detail": {"type": "string"},
          "severity": {"type": "string", "enum": ["critical", "warning", "normal", "info"]}
        }
      }
    },
    "checklist": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["value", "status"],
        "properties": {
          "value": {"type": "string"},
          "status": {"type": "string", "enum": ["critical", "warning", "normal", "info"]}
        }
      }
    }
  }
}
