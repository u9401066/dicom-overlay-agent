{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dicom-overlay-agent.local/schema/clinical-rule-v1.json",
  "title": "DICOM Overlay Agent clinical rule registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "registry_version", "rules"],
  "properties": {
    "schema_version": {"const": 1},
    "registry_version": {"$ref": "#/$defs/semanticVersion"},
    "rules": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/rule"}
    }
  },
  "$defs": {
    "semanticVersion": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "nonEmptyString": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "identifier": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "ruleIdentifier": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$"
    },
    "modality": {
      "type": "string",
      "enum": ["EKG", "CXR", "CT_BRAIN"]
    },
    "severity": {
      "type": "string",
      "enum": ["normal", "info", "warning", "critical"]
    },
    "date": {
      "type": "string",
      "format": "date",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "nonEmptyStringArray": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/nonEmptyString"}
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authority",
        "title",
        "version",
        "effective_date",
        "url",
        "locator"
      ],
      "properties": {
        "authority": {"$ref": "#/$defs/nonEmptyString"},
        "title": {"$ref": "#/$defs/nonEmptyString"},
        "version": {"$ref": "#/$defs/nonEmptyString"},
        "effective_date": {"$ref": "#/$defs/date"},
        "url": {"type": "string", "pattern": "^https://\\S+$"},
        "locator": {"$ref": "#/$defs/nonEmptyString"}
      }
    },
    "workflowStep": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "detail"],
      "properties": {
        "id": {"$ref": "#/$defs/identifier"},
        "detail": {"$ref": "#/$defs/nonEmptyString"}
      }
    },
    "human": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "rationale",
        "workflow",
        "sources",
        "reviewed_on",
        "review_due"
      ],
      "properties": {
        "title": {"$ref": "#/$defs/nonEmptyString"},
        "rationale": {"$ref": "#/$defs/nonEmptyString"},
        "workflow": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/workflowStep"}
        },
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/source"}
        },
        "reviewed_on": {"$ref": "#/$defs/date"},
        "review_due": {"$ref": "#/$defs/date"}
      }
    },
    "agentStep": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "instruction"],
      "properties": {
        "id": {"$ref": "#/$defs/identifier"},
        "instruction": {"$ref": "#/$defs/nonEmptyString"}
      }
    },
    "agent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["steps"],
      "properties": {
        "steps": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/agentStep"}
        }
      }
    },
    "priority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tier", "basis", "conflicts_with"],
      "properties": {
        "tier": {
          "type": "string",
          "enum": ["review", "info", "warning", "critical"]
        },
        "basis": {
          "type": "string",
          "enum": ["product_safety_policy", "clinical_consistency_review"]
        },
        "conflicts_with": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/ruleIdentifier"}
        }
      }
    },
    "runtimeCondition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["field", "op"],
      "properties": {
        "field": {
          "type": "string",
          "pattern": "^(severity|summary|all_text|checklist\\.[a-z][a-z0-9_]*(?:\\.status)?)$"
        },
        "op": {
          "type": "string",
          "enum": [
            "contains_any",
            "contains_any_asserted",
            "contains_any_non_negated",
            "not_contains_any",
            "equals",
            "severity_at_most",
            "severity_at_least"
          ]
        },
        "values": {"$ref": "#/$defs/nonEmptyStringArray"},
        "value": {"$ref": "#/$defs/nonEmptyString"}
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["conditions", "message", "escalate_to", "require_review"],
      "properties": {
        "conditions": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/runtimeCondition"}
        },
        "message": {"$ref": "#/$defs/nonEmptyString"},
        "escalate_to": {
          "type": ["string", "null"],
          "enum": ["normal", "info", "warning", "critical", null]
        },
        "require_review": {"type": "boolean"}
      }
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": ["axes", "severity_floor_if_confirmed"],
      "properties": {
        "axes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/identifier"}
        },
        "severity_floor_if_confirmed": {
          "type": ["string", "null"],
          "enum": ["normal", "info", "warning", "critical", null]
        }
      }
    },
    "tests": {
      "type": "object",
      "additionalProperties": false,
      "required": ["positive", "negative", "uncertain", "partial"],
      "properties": {
        "positive": {"$ref": "#/$defs/nonEmptyStringArray"},
        "negative": {"$ref": "#/$defs/nonEmptyStringArray"},
        "uncertain": {"$ref": "#/$defs/nonEmptyStringArray"},
        "partial": {"$ref": "#/$defs/nonEmptyStringArray"}
      }
    },
    "legacy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runtime_id", "source"],
      "properties": {
        "runtime_id": {"$ref": "#/$defs/ruleIdentifier"},
        "source": {
          "type": "string",
          "pattern": "^(?![/\\\\])(?!.*(?:^|[/\\\\])\\.\\.(?:[/\\\\]|$))[^\\r\\n]+$"
        }
      }
    },
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rule_id",
        "version",
        "modality",
        "status",
        "human",
        "preconditions",
        "evidence",
        "exclusions",
        "priority",
        "agent",
        "runtime",
        "output",
        "tests",
        "legacy"
      ],
      "properties": {
        "rule_id": {"$ref": "#/$defs/ruleIdentifier"},
        "version": {"$ref": "#/$defs/semanticVersion"},
        "modality": {"$ref": "#/$defs/modality"},
        "status": {
          "type": "string",
          "enum": ["draft", "active", "deprecated", "retired"]
        },
        "human": {"$ref": "#/$defs/human"},
        "preconditions": {"$ref": "#/$defs/nonEmptyStringArray"},
        "evidence": {"$ref": "#/$defs/nonEmptyStringArray"},
        "exclusions": {"$ref": "#/$defs/nonEmptyStringArray"},
        "priority": {"$ref": "#/$defs/priority"},
        "agent": {"$ref": "#/$defs/agent"},
        "runtime": {"$ref": "#/$defs/runtime"},
        "output": {"$ref": "#/$defs/output"},
        "tests": {"$ref": "#/$defs/tests"},
        "legacy": {"$ref": "#/$defs/legacy"}
      }
    },
    "axisDocument": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "modality", "axes"],
      "properties": {
        "schema_version": {"const": 1},
        "modality": {"$ref": "#/$defs/modality"},
        "axes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/identifier"}
        }
      }
    },
    "inventoryEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "legacy_id",
        "layer",
        "status",
        "source",
        "locator",
        "parity_test"
      ],
      "properties": {
        "legacy_id": {"$ref": "#/$defs/ruleIdentifier"},
        "layer": {
          "type": "string",
          "enum": [
            "runtime",
            "application_guard",
            "prompt_contract",
            "output_validator"
          ]
        },
        "status": {
          "type": "string",
          "enum": ["mapped", "intentional_local"]
        },
        "canonical_rule": {"$ref": "#/$defs/ruleIdentifier"},
        "source": {
          "type": "string",
          "pattern": "^(?![/\\\\])(?!.*(?:^|[/\\\\])\\.\\.(?:[/\\\\]|$))[^\\r\\n]+$"
        },
        "locator": {"$ref": "#/$defs/nonEmptyString"},
        "parity_test": {
          "type": "string",
          "pattern": "^(?![/\\\\])(?!.*(?:^|[/\\\\])\\.\\.(?:[/\\\\]|$))[^\\r\\n:]+::[A-Za-z_][A-Za-z0-9_]*(?:::[A-Za-z_][A-Za-z0-9_]*)*$"
        },
        "note": {"$ref": "#/$defs/nonEmptyString"}
      }
    },
    "inventoryDocument": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "entries"],
      "properties": {
        "schema_version": {"const": 1},
        "entries": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/inventoryEntry"}
        }
      }
    }
  }
}
