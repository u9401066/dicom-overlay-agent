{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dicom-overlay-agent.local/schema/reading-contract-v1.json",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "contract_version", "scope", "quality_focus", "stages", "rule_guidance_stages"],
  "properties": {
    "schema_version": {"const": 1},
    "contract_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "scope": {"const": "single_authorized_image"},
    "rule_guidance_stages": {"type": "array", "items": {"type": "string", "enum": ["reconcile", "targeted_second_look"]}, "uniqueItems": true},
    "quality_focus": {
      "type": "object", "additionalProperties": false, "required": ["EKG", "CXR", "CT_BRAIN"],
      "properties": {"EKG": {"$ref": "#/$defs/pair"}, "CXR": {"$ref": "#/$defs/pair"}, "CT_BRAIN": {"$ref": "#/$defs/pair"}}
    },
    "stages": {"type": "array", "minItems": 5, "maxItems": 5, "items": {"$ref": "#/$defs/stage"}}
  },
  "$defs": {
    "text": {"type": "string", "minLength": 1, "maxLength": 4000, "pattern": "\\S"},
    "pair": {"type": "object", "additionalProperties": false, "required": ["human", "agent"], "properties": {"human": {"$ref": "#/$defs/text"}, "agent": {"$ref": "#/$defs/text"}}},
    "step": {
      "type": "object", "additionalProperties": false, "required": ["id", "human", "agent"],
      "properties": {"id": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"}, "human": {"$ref": "#/$defs/text"}, "agent": {"$ref": "#/$defs/text"}}
    },
    "stage": {
      "type": "object", "additionalProperties": false, "required": ["id", "human_title", "steps"],
      "properties": {
        "id": {"type": "string", "enum": ["quality_gate", "blind_pass", "independent_evidence", "reconcile", "targeted_second_look"]},
        "human_title": {"$ref": "#/$defs/text"},
        "steps": {"type": "array", "minItems": 1, "maxItems": 20, "items": {"$ref": "#/$defs/step"}}
      }
    }
  }
}
